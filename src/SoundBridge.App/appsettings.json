{
  "SoundBridge": {
    "FriendlyName": "SoundBridge",
    "Manufacturer": "SoundBridge",
    "UdnFilePath": "data/device.udn",
    "MediaHost": "192.168.0.22",
    "MediaPort": 5000,
    "LibraryRoots": [
      {
        "Name": "Muzyka",
        "Path": "I:\\music"
      },
      {
        "Name": "Radio",
        "Path": "I:\\radio"
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "data/logs/soundbridge-.log", "rollingInterval": "Day" } }
    ]
  }
}
