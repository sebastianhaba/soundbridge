<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundBridge.App</RootNamespace>
    <OutputType>Exe</OutputType>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32bit>true</Prefer32bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ohNet" Version="1.40.5989.300" />
    <PackageReference Include="ohNet.NET" Version="1.40.5989.300" />
    <PackageReference Include="ohNetGeneratedProviders.Combined" Version="1.40.5989.300" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyOhNetNative" AfterTargets="Publish">
    <ItemGroup>
      <OhNetNative Include="$(NuGetPackageRoot)ohnet/**/libohNet.so" />
    </ItemGroup>
    <Copy SourceFiles="@(OhNetNative)" DestinationFolder="$(PublishDir)" />
  </Target>

  <Target Name="RemoveOhNetFrameworkDll" AfterTargets="Publish">
    <Delete Files="$(PublishDir)ohNet.dll" Condition="Exists('$(PublishDir)ohNet.dll')" />
  </Target>
</Project>
