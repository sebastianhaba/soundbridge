<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundBridge.App</RootNamespace>
    <OutputType>Exe</OutputType>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <PlatformTarget>x86</PlatformTarget>

  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoundBridge.Abstractions\SoundBridge.Abstractions.csproj" />
    <ProjectReference Include="..\SoundBridge.Shared\SoundBridge.Shared.csproj" />
    <ProjectReference Include="..\SoundBridge.Libraries.LocalLibrary\SoundBridge.Libraries.LocalLibrary.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="ohNet" Version="1.40.5989.300" />
    <PackageReference Include="ohNet.NET" Version="1.40.5989.300" />
    <PackageReference Include="ohNetGeneratedProviders.Combined" Version="1.40.5989.300" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <Target Name="CopyOhNetNative" AfterTargets="Publish">
    <ItemGroup>
      <OhNetNative Include="$(NuGetPackageRoot)ohnet*/**/lib/mono/x64/libohNet.so" />
    </ItemGroup>
    <Copy SourceFiles="@(OhNetNative)" DestinationFolder="$(PublishDir)" />
    <Message Importance="high" Text="Copied libohNet.so from %(OhNetNative.Identity)" Condition="@(OhNetNative->Count()) &gt; 0" />
    <Error Text="libohNet.so not found in NuGet cache" Condition="@(OhNetNative->Count()) == 0" />
  </Target>

  <Target Name="RemoveOhNetFrameworkDll" AfterTargets="Publish">
    <Delete Files="$(PublishDir)ohNet.dll" Condition="Exists('$(PublishDir)ohNet.dll')" />
  </Target>
</Project>
